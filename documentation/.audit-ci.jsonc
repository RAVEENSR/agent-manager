{
  // Fail the build on high (and critical) severity advisories in production
  // dependencies, matching the previous `npm audit --audit-level=high --omit=dev`.
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // image-size: ICNS / JXL / HEIF parsers allow denial of service through
    // infinite loops. Every published version (<= 2.0.2) is affected and there
    // is no patched release, so this cannot be resolved by upgrading or by an
    // override. It reaches us only through @docusaurus/mdx-loader, which uses
    // it at build time to measure images committed to this repository, so the
    // malformed-input path is not reachable from user input.
    // Remove these entries once image-size ships a fix.
    "GHSA-w3rx-r6r6-pgpr",
    "GHSA-5p2g-fcmc-qvqq"
  ]
}
