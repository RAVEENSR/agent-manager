OPENAI_API_KEY=

# Local runs only. Platform-hosted chat agents are always routed to 8000.
PORT=8000

# Local testing only: lets a browser call this agent directly. When deployed,
# leave it unset and allow the origin in Agent Manager's CORS settings instead.
CORS_ALLOW_ORIGINS=http://localhost:5173

